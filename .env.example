# Email is OPTIONAL. Without this file filled in, the app just skips
# sending emails and prints a note in the terminal instead — nothing breaks.
#
# To turn on real email sending (using a free Gmail account):
# 1. Copy this file and rename the copy to exactly: .env
# 2. Go to https://myaccount.google.com/apppasswords and create an "App Password"
#    (this requires 2-Step Verification to be turned on for your Google account)
# 3. Paste your Gmail address and the 16-character app password below
# 4. Restart the server (npm start)
#
# Never share your .env file or commit it to GitHub — it contains a real password.

# SESSION_SECRET signs the login session cookie. Without this set, the app
# falls back to a built-in development secret and prints a warning — logins
# still work, but anyone with a copy of this source code could forge a
# session cookie. Set this before putting real tenant data anywhere but
# your own machine.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=

EMAIL_USER=youraddress@gmail.com
EMAIL_APP_PASSWORD=your16characterapppassword

# "Continue with Google" is OPTIONAL. Without this filled in, the Google
# button just stays hidden on the login/register pages — nothing breaks.
#
# To turn it on (free, no cost, takes about 5 minutes):
# 1. Go to https://console.cloud.google.com/ and create a new project (any name)
# 2. Go to "APIs & Services" > "OAuth consent screen" — choose "External",
#    fill in the basic required fields (app name, your email), and save.
#    You can leave it in "Testing" mode — no need to publish it.
# 3. Go to "APIs & Services" > "Credentials" > "Create Credentials" >
#    "OAuth client ID" > Application type: "Web application"
# 4. Under "Authorized JavaScript origins" add: http://localhost:3000
# 5. Copy the "Client ID" it gives you (NOT the client secret — this app
#    doesn't need that) and paste it below
# 6. Restart the server (npm start)

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# WhatsApp auto-reminders and WhatsApp sign-up codes are OPTIONAL, powered by
# Twilio. Without these filled in, the app just logs what it would have sent
# to the terminal instead of crashing — email reminders/codes still work fine.
#
# To turn on real WhatsApp sending:
# 1. Go to https://www.twilio.com/try-twilio and create a free account
#    (no credit card needed for the sandbox — it's free to test with)
# 2. In the Twilio Console, go to Messaging > Try it out > Send a WhatsApp message
#    to activate your WhatsApp Sandbox, and follow the on-screen steps to join it
#    from your own phone (you send a short code by WhatsApp to their number once)
# 3. Copy your "Account SID" and "Auth Token" from the Console dashboard
# 4. Copy the sandbox's WhatsApp number shown there (looks like +14155238886)
# 5. Paste all three below, then restart the server (npm start)
#
# Note: anyone you want to message (tenants, or new sign-ups verifying by
# WhatsApp) must first join your sandbox the same one-time way, until you
# upgrade to a paid Twilio WhatsApp sender for production use.

TWILIO_ACCOUNT_SID=ACyourAccountSidHere
TWILIO_AUTH_TOKEN=youraAuthTokenHere
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

